rules_version = '2';

// Reglas de Firestore para Morfo-Trainer.
// En Firestore: "dudas" y "perfiles". En Google Sheets todavía: el roster
// "Estudiantes", los "Resultados" (informes) y el contenido de preguntas.
//
// Seguridad: la app abre una sesión anónima de Firebase, así que solo se
// puede leer/escribir desde la propia web. Los datos no son sensibles
// (nombre, código, progreso de práctica, texto de dudas y respuestas).

service cloud.firestore {
  match /databases/{database}/documents {

    // Perfil de cada estudiante: nombre, progreso, cronómetros.
    match /perfiles/{code} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.data.name is string
        && request.resource.data.get('progress', {}).keys().size() < 800
        && request.resource.data.get('timers', {}).keys().size() < 200;
    }

    match /dudas/{id} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.code is string
        && request.resource.data.code.size() > 0
        && request.resource.data.q is string
        && request.resource.data.q.size() <= 1000
        && request.resource.data.get('nota', '').size() <= 800;

      allow update: if request.auth != null
        && request.resource.data.code == resource.data.code
        && request.resource.data.q == resource.data.q
        && request.resource.data.get('nota', '').size() <= 800
        && request.resource.data.get('respuesta', '').size() <= 3000;

      allow delete: if request.auth != null;
    }

    // Nada más es accesible desde el cliente.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
